{"resourceType": "PlanDefinition", "id": "11", "name": "P11", "title": "Hypertension Management Pathway", "description": "The patient completes a general health questionnaire twice a day and measures blood pressure. If blood pressure is between the defined low and high thresholds, the practitioner is alerted urgently; if it exceeds the high threshold, the emergency team is alerted with stat priority. The patient takes ramipril 2.5 mg once daily. Every six months, the patient attends a cardiology specialist follow-up visit.", "status": "draft", "action": [{"linkId": "A1", "title": "The patient completes a general health questionnaire twice a day", "timingTiming": {"repeat": {"frequency": 2, "period": 1, "periodUnit": "d"}}, "definitionCanonical": "ActivityDefinition/1002", "dynamicValue": [{"path": "supportingInfo[0].reference", "expression": {"description": "general health questionnaire", "language": "text/fhirpath", "expression": "general health questionnaire"}}]}, {"linkId": "A2", "title": "The patient measures blood pressure", "relatedAction": [{"targetId": "A1", "relationship": "after-end"}], "definitionCanonical": "ActivityDefinition/1058", "dynamicValue": [{"path": "code.concept", "expression": {"description": "blood pressure", "language": "text/fhirpath", "expression": "{\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"75367002\", \"display\": \"Blood pressure\"}], \"text\": \"blood pressure\"}"}}]}, {"linkId": "A3", "title": "If blood pressure is between the defined low and high thresholds, the practitioner is alerted urgently", "condition": [{"kind": "applicability", "expression": {"description": "If blood pressure is between the defined low and high thresholds", "language": "text/fhirpath", "expression": "TODO"}}], "relatedAction": [{"targetId": "A2", "relationship": "after-end"}], "definitionCanonical": "ActivityDefinition/1051", "dynamicValue": [{"path": "priority", "expression": {"description": "urgently", "language": "text/fhirpath", "