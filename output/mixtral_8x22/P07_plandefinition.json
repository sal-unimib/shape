{"resourceType": "PlanDefinition", "id": "7", "name": "P07", "title": "Oncology Chemotherapy Monitoring Pathway", "status": "draft", "description": "Following blood sample collection, if laboratory results are normal, chemotherapy is administered while vital signs are monitored. Otherwise, the practitioner is alerted and an ECG performed.", "action": [{"linkId": "A1", "title": "following blood sample collection"}, {"linkId": "A2", "title": "if laboratory results are normal", "condition": [{"kind": "applicability", "expression": {"description": "laboratory results are normal", "language": "text/fhirpath", "expression": "TODO"}}], "relatedAction": [{"targetId": "A1", "relationship": "after-end"}]}, {"linkId": "A3", "title": "chemotherapy is administered while vital signs are monitored", "relatedAction": [{"targetId": "A2", "relationship": "after-end"}], "dynamicValue": [{"path": "code.concept", "expression": {"description": "vital signs", "language": "text/fhirpath", "expression": "{\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"118227000\", \"display\": \"Vital signs finding (finding)\"}], \"text\": \"vital signs\"}"}}]}, {"linkId": "A4", "title": "Otherwise, the practitioner is alerted", "condition": [{"kind": "applicability", "expression": {"description": "laboratory results are not normal", "language": "text/fhirpath", "expression": "TODO"}}], "relatedAction": [{"targetId": "A1", "relationship": "after-end"}]}, {"linkId": "A5", "title": "an ECG performed", "relatedAction": [{"targetId": "A4", "relationship": "after-end"}], "dynamicValue": [{"path": "code.concept", "expression": {"description": "ECG", "language": "text/fhirpath", "expression": "{\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"29303009\", \"display\": \"Electrocardiogram\"}], \"text\": \"ECG\"}"}}]}]}