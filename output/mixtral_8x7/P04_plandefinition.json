{"resourceType": "PlanDefinition", "id": "4", "name": "P04", "title": "Post-surgical Infection Monitoring", "status": "draft", "description": "Every morning the patient applies the prescribed medication and measures body temperature. If body temperature exceeds 38\u00b0C, a post-surgical infection screening questionnaire is administered and then the practitioner is alerted as urgent.", "action": [{"linkId": "A1", "title": "the patient applies the prescribed medication", "dynamicValue": [{"path": "medication.concept", "expression": {"description": "the prescribed medication", "language": "text/fhirpath", "expression": "{\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"386465007\", \"display\": \"Instruction about prescribed medications\"}], \"text\": \"the prescribed medication\"}"}}]}, {"linkId": "A2", "title": "measure body temperature", "relatedAction": [{"targetId": "A1", "relationship": "after-end"}], "dynamicValue": [{"path": "code.concept", "expression": {"description": "body temperature", "language": "text/fhirpath", "expression": "{\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"386725007\", \"display\": \"Body temperature (observable entity)\"}], \"text\": \"body temperature\"}"}}]}, {"linkId": "A3", "title": "administer post-surgical infection screening questionnaire"}, {"linkId": "A4", "title": "alert practitioner as urgent", "relatedAction": [{"targetId": "A3", "relationship": "after-end"}], "dynamicValue": [{"path": "priority", "expression": {"description": "as urgent", "language": "text/fhirpath", "expression": "{\"code\": \"urgent\", \"title\": \"Urgent\", \"confidence\": \"MEDIUM\"}"}}]}]}