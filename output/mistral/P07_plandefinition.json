{"resourceType": "PlanDefinition", "id": "7", "name": "P07", "title": "Oncology Chemotherapy Monitoring Pathway", "status": "draft", "description": "Following blood sample collection, if laboratory results are normal, chemotherapy is administered while vital signs are monitored. Otherwise, the practitioner is alerted and an ECG performed.", "action": [{"linkId": "A1", "title": "Following blood sample collection"}, {"linkId": "A2", "title": "laboratory results are normal", "relatedAction": [{"targetId": "A1", "relationship": "after-end"}], "dynamicValue": [{"path": "code.concept", "expression": {"description": "laboratory results", "language": "text/fhirpath", "expression": "{\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"275924004\", \"display\": \"Result, lab.- general (observable entity)\"}], \"text\": \"laboratory results\"}"}}]}, {"linkId": "A3", "title": "chemotherapy is administered", "relatedAction": [{"targetId": "A2", "relationship": "after-end"}]}, {"linkId": "A4", "title": "vital signs are monitored", "relatedAction": [{"targetId": "A2", "relationship": "after-end"}]}, {"linkId": "A5", "title": "the practitioner is alerted"}, {"linkId": "A6", "title": "an ECG is performed", "relatedAction": [{"targetId": "A5", "relationship": "after-end"}]}]}