{"resourceType": "PlanDefinition", "id": "11", "name": "P11", "title": "Hypertension Management Pathway", "status": "draft", "description": "The patient completes a general health questionnaire twice a day and measures blood pressure. If blood pressure is between the defined low and high thresholds, the practitioner is alerted urgently; if it exceeds the high threshold, the emergency team is alerted with stat priority. The patient takes ramipril 2.5 mg once daily. Every six months, the patient attends a cardiology specialist follow-up visit.", "action": [{"linkId": "A1", "title": "completes a general health questionnaire twice a day", "timingTiming": {"repeat": {"frequency": 2, "period": 1, "periodUnit": "d"}}, "dynamicValue": [{"path": "supportingInfo[0].reference", "expression": {"description": "a general health questionnaire", "language": "text/fhirpath", "expression": "a general health questionnaire"}}]}, {"linkId": "A2", "title": "measures blood pressure", "dynamicValue": [{"path": "code.concept", "expression": {"description": "blood pressure", "language": "text/fhirpath", "expression": "{\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"75367002\", \"display\": \"Blood pressure\"}], \"text\": \"blood pressure\"}"}}]}, {"linkId": "A3", "title": "the practitioner is alerted urgently", "condition": [{"kind": "applicability", "expression": {"description": "blood pressure is between the defined low and high thresholds", "language": "text/fhirpath", "expression": "TODO"}}], "relatedAction": [{"targetId": "A2", "relationship": "after-end"}], "dynamicValue": [{"path": "priority", "expression": {"description": "urgently", "language": "text/fhirpath", "expression": "{\"code\": \"urgent\", \"title\": \"Urgent\", \"confidence\": \"HIGH\"}"}}]}, {"linkId": "A4", "title": "the emergency team is alerted with stat priority", "condition": [{"kind": "applicability", "expression": {"description": "blood pressure exceeds the high threshold", "language": "text/fhirpath", "expression": "TODO"}}], "relatedAction": [{"targetId": "A2", "relationship": "after-end"}], "dynamicValue": [{"path": "priority", "expression": {"description": "stat priority", "language": "text/fhirpath", "expression": "{\"code\": \"stat\", \"title\": \"STAT\", \"confidence\": \"HIGH\"}"}}]}, {"linkId": "A5", "title": "takes ramipril 2.5 mg once daily", "timingTiming": {"repeat": {"frequency": 1, "period": 1, "periodUnit": "d"}}}, {"linkId": "A6", "title": "attends a cardiology specialist follow-up visit", "dynamicValue": [{"path": "code.concept", "expression": {"description": "cardiology specialist", "language": "text/fhirpath", "expression": "{\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"17561000\", \"display\": \"Cardiologist\"}], \"text\": \"cardiology specialist\"}"}}]}]}