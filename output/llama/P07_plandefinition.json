{"resourceType": "PlanDefinition", "id": "7", "name": "P07", "title": "Oncology Chemotherapy Monitoring Pathway", "status": "draft", "description": "Following blood sample collection, if laboratory results are normal, chemotherapy is administered while vital signs are monitored. Otherwise, the practitioner is alerted and an ECG performed.", "action": [{"linkId": "A1", "title": "blood sample collection", "dynamicValue": [{"path": "code.concept", "expression": {"description": "blood", "language": "text/fhirpath", "expression": "None"}}]}, {"linkId": "A2", "title": "chemotherapy is administered", "condition": [{"kind": "applicability", "expression": {"description": "laboratory results are normal", "language": "text/fhirpath", "expression": "TODO"}}], "relatedAction": [{"targetId": "A1", "relationship": "after-end"}], "dynamicValue": [{"path": "medication.concept", "expression": {"description": "chemotherapy", "language": "text/fhirpath", "expression": "{\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"150415003\", \"display\": \"Chemotherapy\"}], \"text\": \"chemotherapy\"}"}}]}, {"linkId": "A3", "title": "vital signs are monitored", "relatedAction": [{"targetId": "A2", "relationship": "after-end"}], "timingTiming": {"repeat": {"when": ["IMD"]}}, "dynamicValue": [{"path": "code.concept", "expression": {"description": "vital signs", "language": "text/fhirpath", "expression": "{\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"46680005\", \"display\": \"Vital sign (observable entity)\"}], \"text\": \"vital signs\"}"}}]}, {"linkId": "A4", "title": "the practitioner is alerted", "condition": [{"kind": "applicability", "expression": {"description": "laboratory results are not normal", "language": "text/fhirpath", "expression": "TODO"}}], "relatedAction": [{"targetId": "A1", "relationship": "after-end"}]}, {"linkId": "A5", "title": "an ECG performed", "relatedAction": [{"targetId": "A4", "relationship": "after-end", "offsetDuration": {}}], "dynamicValue": [{"path": "code.concept", "expression": {"description": "ECG", "language": "text/fhirpath", "expression": "{\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"29303009\", \"display\": \"Electrocardiogram:\"}], \"text\": \"ECG\"}"}}]}]}