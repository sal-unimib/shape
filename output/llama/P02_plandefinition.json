{"resourceType": "PlanDefinition", "id": "2", "name": "P02", "title": "Heart Failure Follow-up Management", "status": "draft", "description": "The patient completes a post-stroke follow up questionnaire. Thereafter, vital signs are monitored for ten days, and the practitioner is alerted with urgent priority if abnormal values are detected. In parallel, the patient attends a cardiology specialist follow-up visit and subsequently receives post-stroke lifestyle education.", "action": [{"linkId": "A1", "title": "The patient completes a post-stroke follow up questionnaire.", "dynamicValue": [{"path": "supportingInfo[0].reference", "expression": {"description": "post-stroke follow up questionnaire", "language": "text/fhirpath", "expression": "post-stroke follow up questionnaire"}}]}, {"linkId": "A2", "title": "vital signs are monitored for ten days", "relatedAction": [{"targetId": "A1", "relationship": "after-end"}], "timingTiming": {"repeat": {"boundsDuration": {"value": 10, "unit": "d", "system": "http://unitsofmeasure.org"}}}, "dynamicValue": [{"path": "code.concept", "expression": {"description": "vital signs", "language": "text/fhirpath", "expression": "{\"coding\": [{\"system\": \"http://snomed.info/sct\", \"code\": \"46680005\", \"display\": \"Vital sign (observable entity)\"}], \"text\": \"vital signs\"}"}}]}, {"linkId": "A3", "title": "the practitioner is alerted with urgent priority if abnormal values are detected", "condition": [{"kind": "applicability", "expression": {"description": "abnormal values are detected", "language": "text/fhirpath", "expression": "TODO"}}], "relatedAction": [{"targetId": "A2", "relationship": "after-end"}], "dynamicValue": [{"path": "priority", "expression": {"description": "urgent priority", "language": "text/fhirpath", "expression": "{\"code\": \"urgent\", \"title\": \"Urgent\", \"confidence\": \"HIGH\"}"}}]}, {"linkId": "A4", "title": "the patient attends a cardiology specialist follow-up visit", "relatedAction": [{"targetId": "A1